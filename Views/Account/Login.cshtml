@{ ViewData["Title"] = "Acceso organizador"; ViewData["BodyClass"] = "auth-page"; }
<section class="auth-wrap"><div class="auth-panel"><div class="auth-brand"><span class="brand-mark">ST</span><div><strong>SprinTime</strong><small>Control Center</small></div></div><span class="eyebrow">ACCESO PRIVADO</span><h1>Operá la carrera,<br/><em>no una planilla.</em></h1><p>Ingresá al cockpit del organizador para gestionar inscriptos, pagos, acreditación, Race Day y resultados.</p></div><form method="post" class="auth-card"><input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl"/><h2>Iniciar sesión</h2><p>Usá las credenciales configuradas en <code>AdminAuth</code>.</p>@if(ViewBag.Error is string error){<div class="validation-summary">@error</div>}<label class="field"><span>Email</span><input type="email" name="email" required autocomplete="username"/></label><label class="field"><span>Contraseña</span><input type="password" name="password" required autocomplete="current-password"/></label><button class="btn btn-primary btn-lg btn-block" type="submit">Entrar al Control Center <span>→</span></button><small class="auth-help">En desarrollo: admin@sprintime.local</small></form></section>
