@model List<Registration>
@{ var race=(Event)ViewBag.Event; ViewData["Title"]="Seguí a tu corredor · "+race.Name; }
<section class="page-hero compact follow-hero"><div class="shell"><span class="eyebrow">EN CARRERA</span><h1>Seguí a tu <em>corredor.</em></h1><p>Buscá por dorsal o nombre y consultá el último paso registrado. No necesitás crear una cuenta.</p></div></section>
<section class="section"><div class="shell follow-shell"><form method="get" class="follow-search"><input name="q" value="@ViewBag.Query" placeholder="Dorsal o nombre" autofocus/><button class="btn btn-primary btn-lg">Buscar corredor</button></form>@foreach(var r in Model){var ordered=r.TimingRecords.OrderBy(x=>x.Checkpoint.Order).ThenBy(x=>x.TimestampUtc).ToList();<article class="follow-card"><div class="follow-rider"><span class="follow-bib">#@(r.BibNumber??"—")</span><div><h2>@r.Cyclist.FirstName @r.Cyclist.LastName</h2><p>@r.Category.Name · @r.EventDistance.Name</p></div><span class="status-pill @(r.CheckInStatus==CheckInStatus.Finished?"ok":"pending")">@r.CheckInStatus</span></div><div class="follow-timeline">@foreach(var cp in race.Checkpoints.OrderBy(x=>x.Order)){var pass=ordered.FirstOrDefault(x=>x.CheckpointId==cp.Id);<div class="@(pass is null?"future":"passed")"><i></i><span><b>@cp.Name</b><small>km @cp.Kilometer.ToString("0.#")</small></span><strong>@(pass?.TimestampUtc.ToLocalTime().ToString("HH:mm:ss")??"Pendiente")</strong></div>}</div></article>}@if(!string.IsNullOrWhiteSpace(ViewBag.Query as string)&&Model.Count==0){<div class="empty-state"><span>?</span><h3>No encontramos ese corredor.</h3><p>Probá con el dorsal o una parte del nombre.</p></div>}</div></section>
