@model CommunitySponsorInput
@{ ViewData["Title"] = Model.Id.HasValue ? "Editar auspiciante" : "Nuevo auspiciante"; ViewData["BodyClass"] = "admin-page"; }
<section class="section form-section"><div class="shell narrow"><a class="back-link" asp-action="ManageSponsors">← Administrar auspiciantes</a><h1>@ViewData["Title"]</h1>
<form asp-action="EditSponsor" method="post" enctype="multipart/form-data" class="premium-form"><input type="hidden" asp-for="Id"/><div asp-validation-summary="All" class="validation-summary"></div>
<div class="form-card"><div class="field-grid">
<label class="field span-2"><span>Nombre del negocio o marca</span><input asp-for="Name" required maxlength="120"/></label>
<label class="field span-2"><span>Descripción breve</span><textarea asp-for="Description" rows="4" maxlength="600"></textarea></label>
<label class="field span-2"><span>Enlace del negocio (opcional)</span><input asp-for="LinkUrl" type="url" placeholder="https://ejemplo.com o dejalo vacío" /><small>Este enlace es para abrir la web o Instagram del auspiciante al tocar su logo. Si no tiene, dejá el campo vacío. No sirve para subir la imagen.</small><span asp-validation-for="LinkUrl" class="field-error"></span></label>
<label class="field span-2"><span>Subir logo o fotografía del auspiciante (JPG, PNG o WebP, máximo 5 MB)</span><input asp-for="LogoFile" type="file" accept=".jpg,.jpeg,.png,.webp" data-sponsor-upload/><small>Elegí la imagen desde tu computadora. Cuando esté seleccionada, aparecerá debajo.</small><span asp-validation-for="LogoFile" class="field-error"></span><span data-sponsor-preview-wrapper hidden style="margin-top:12px"><img data-sponsor-preview alt="Vista previa del logo" style="display:block;max-width:220px;max-height:180px;object-fit:contain;border-radius:12px"/></span></label>
@if (!string.IsNullOrWhiteSpace(Model.LogoUrl)) { <div class="span-2"><img src="@Model.LogoUrl" alt="Logo actual" style="max-width:200px;max-height:160px;object-fit:contain"/><label class="check-field"><input asp-for="RemoveLogo"/> Quitar logo actual</label></div> }
<label class="field"><span>Orden de aparición</span><input asp-for="DisplayOrder" type="number"/></label>
</div><label class="check-field"><input asp-for="IsPublished"/> Mostrar en la página de auspiciantes</label></div>
<button type="submit" class="btn btn-primary btn-lg">Guardar auspiciante →</button>
</form></div></section>
@section Scripts {
  <partial name="_ValidationScriptsPartial" />
  <script>
    (() => {
      const input = document.querySelector("[data-sponsor-upload]");
      const preview = document.querySelector("[data-sponsor-preview]");
      const wrapper = document.querySelector("[data-sponsor-preview-wrapper]");
      let objectUrl;
      input?.addEventListener("change", () => {
        if (objectUrl) URL.revokeObjectURL(objectUrl);
        const file = input.files?.[0];
        wrapper.hidden = !file;
        if (!file) { preview.removeAttribute("src"); return; }
        objectUrl = URL.createObjectURL(file);
        preview.src = objectUrl;
      });
    })();
  </script>
}