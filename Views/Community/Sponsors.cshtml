@model List<CommunitySponsor>
@{ ViewData["Title"] = "Auspiciantes"; }
<section class="page-hero compact"><div class="shell"><span class="eyebrow">QUIENES NOS ACOMPAÑAN</span><h1>Nuestros <em>auspiciantes.</em></h1><p>Negocios, marcas y personas que hacen crecer el ciclismo.</p></div></section>
<section class="section"><div class="shell">
@if (Model.Count == 0) { <div class="empty-state"><h2>Muy pronto, nuestros auspiciantes</h2><p>Estamos preparando este espacio.</p></div> }
else {
<div class="sponsor-community-grid">
@foreach (var sponsor in Model) {
<article class="sponsor-community-card">
@if (!string.IsNullOrWhiteSpace(sponsor.LinkUrl)) { <a href="@sponsor.LinkUrl" target="_blank" rel="noopener noreferrer" aria-label="Visitar @sponsor.Name">
@if (!string.IsNullOrWhiteSpace(sponsor.LogoUrl)) { <img src="@sponsor.LogoUrl" alt="Logo @sponsor.Name" loading="lazy"/> } else { <div class="sponsor-placeholder">ST</div> }
</a> }
else { @if (!string.IsNullOrWhiteSpace(sponsor.LogoUrl)) { <img src="@sponsor.LogoUrl" alt="Logo @sponsor.Name" loading="lazy"/> } else { <div class="sponsor-placeholder">ST</div> } }
<h2>@sponsor.Name</h2>
@if (!string.IsNullOrWhiteSpace(sponsor.Description)) { <p>@sponsor.Description</p> }
@if (!string.IsNullOrWhiteSpace(sponsor.LinkUrl)) { <a class="btn btn-primary sponsor-visit-btn" href="@sponsor.LinkUrl" target="_blank" rel="noopener noreferrer">Visitar auspiciante <span aria-hidden="true">↗</span></a> }
</article>
}
</div>
}
</div></section>