@model Cyclist
@{ ViewData["Title"]="Espacio ciclista"; var finished=Model.Registrations.Where(x=>x.Result?.TotalTime!=null).ToList(); var kms=Model.Registrations.Where(x => x.Result != null && (x.Result.Status == ResultStatus.Official || x.Result.Status == ResultStatus.Provisional)).Sum(x => x.EventDistance?.Kilometers ?? 0); }
<section class="cyclist-hero"><div class="shell"><div><span class="eyebrow">HOLA, @Model.FirstName.ToUpperInvariant()</span><h1>Tu temporada.<br/><em>Tu progreso.</em></h1><p>@Model.Team · @Model.City</p></div><div class="cyclist-avatar">@Model.FirstName.First()@Model.LastName.First()</div></div></section><section class="section cyclist-dashboard"><div class="shell"><div class="cyclist-metrics"><div><small>CARRERAS</small><strong>@Model.Registrations.Count</strong></div><div><small>KM EN CARRERAS</small><strong>@kms.ToString("N0")</strong></div><div><small>PODIOS</small><strong>@finished.Count(x=>x.Result!.CategoryPosition is <=3 and >0)</strong></div><div><small>PRÓXIMO EVENTO</small><strong>@(Model.Registrations.Where(x=>x.Event.StartDate>DateTime.Now).OrderBy(x=>x.Event.StartDate).Select(x=>x.Event.StartDate.ToString("dd MMM")).FirstOrDefault()??"—")</strong></div></div><div class="cyclist-grid"><section class="admin-card"><div class="admin-card-head"><div><span>MIS CARRERAS</span><h2>Historial y próximas</h2></div></div><div class="compact-list">@foreach(var r in Model.Registrations.OrderByDescending(x=>x.Event.StartDate)){<div><span class="avatar">@r.Event.StartDate.ToString("dd")</span><p><b>@r.Event.Name</b><small>@r.Event.StartDate.ToString("dd MMM yyyy") · @r.EventDistance.Kilometers.ToString("0.#") km · @r.Status @(r.Result?.CategoryPosition is int pos ? $" · Puesto categoría: {pos}" : "")</small></p>@if(r.Result?.TotalTime is TimeSpan t){<strong>@t.ToString(@"hh\:mm\:ss")</strong>}else if(r.PaymentStatus == PaymentStatus.Approved){<a asp-controller="Registration" asp-action="RacePass" asp-route-id="@r.Id">Race Pass →</a>}else{<span>Pago pendiente</span>}</div>}</div></section><section class="admin-card"><div class="admin-card-head"><div><span>MIS BICICLETAS</span><h2>Mantenimiento inteligente</h2></div></div>@if(Model.Bicycles.Count==0){<div class="table-empty">Todavía no hay bicicletas cargadas.</div>}@foreach(var b in Model.Bicycles){<div class="bike-card"><span>MTB</span><h3>@b.Name</h3><p>@b.Brand @b.Model</p><strong>@b.CurrentKilometers.ToString("N0") km</strong><div class="progress"><i style="width:@Math.Min(100,(double)(b.KilometersSinceService/Math.Max(1,b.ServiceEveryKm)*100))%"></i></div><small>Service en @Math.Max(0,b.ServiceEveryKm-(int)b.KilometersSinceService) km</small></div>}</section></div></div></section>
