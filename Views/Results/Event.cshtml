@model List<Result>
@{ var race=(Event)ViewBag.Event; ViewData["Title"]="Resultados · "+race.Name; }
<section class="page-hero compact result-hero"><div class="shell"><span class="eyebrow">RESULTADO OFICIAL</span><h1>@race.Name</h1><p>@race.StartDate.ToString("dd MMM yyyy") · @race.City</p></div></section>
<section class="section"><div class="shell"><form class="filter-bar" method="get"><input type="search" name="q" value="@ViewBag.Query" placeholder="Nombre o dorsal"/><select name="categoryId"><option value="">Todas las categorías</option>@foreach(var c in race.Distances.SelectMany(x=>x.Categories)){<option value="@c.Id" selected="@(ViewBag.CategoryId is int id && id==c.Id)">@c.Name</option>}</select><button class="btn btn-dark">Filtrar</button></form><div class="table-shell"><table class="data-table results-table"><thead><tr><th>#</th><th>Dorsal</th><th>Ciclista</th><th>Categoría</th><th>Tiempo</th><th>Cat.</th><th></th></tr></thead><tbody>@foreach(var r in Model){<tr><td><strong>@(r.GeneralPosition?.ToString() ?? "—")</strong></td><td><span class="bib">@(r.Registration.BibNumber??"—")</span></td><td><b>@r.Registration.Cyclist.FirstName @r.Registration.Cyclist.LastName</b><small>@r.Registration.Cyclist.Team</small></td><td>@r.Registration.Category.Name</td><td class="time">@(r.TotalTime?.ToString(@"hh\:mm\:ss") ?? "—")</td><td>#@(r.CategoryPosition?.ToString()??"—")</td><td><a class="table-action" asp-action="Finisher" asp-route-id="@r.Id">Finisher →</a></td></tr>}</tbody></table>@if(Model.Count==0){<div class="table-empty">No hay resultados que coincidan con la búsqueda.</div>}</div></div></section>
