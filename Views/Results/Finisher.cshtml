@model Result
@{ var r=Model.Registration; ViewData["Title"]="Finisher · "+r.Cyclist.FirstName+" "+r.Cyclist.LastName; ViewData["BodyClass"]="finisher-page"; }
<section class="finisher-wrap"><div class="finisher-card"><div class="finisher-brand"><span class="brand-mark">ST</span><span>SPRINTIME</span></div><div class="finisher-label">FINISHER · @r.EventDistance.Name</div><h1>@r.Cyclist.FirstName<br/>@r.Cyclist.LastName</h1><div class="finisher-time">@(Model.TotalTime?.ToString(@"hh\:mm\:ss")??"—")<small>@(Model.Status == ResultStatus.Official ? "TIEMPO OFICIAL" : "TIEMPO PROVISIONAL · SIN PUBLICAR")</small></div><div class="finisher-ranks"><span><b>#@(Model.CategoryPosition?.ToString()??"—")</b><small>CATEGORÍA</small></span><span><b>#@(Model.GeneralPosition?.ToString()??"—")</b><small>GENERAL</small></span><span><b>@(r.BibNumber??"—")</b><small>DORSAL</small></span></div><div class="finisher-event"><b>@r.Event.Name</b><span>@r.Event.StartDate.ToString("dd MMM yyyy").ToUpperInvariant() · @r.Event.City.ToUpperInvariant()</span></div></div><div class="finisher-actions">@if(Model.Status == ResultStatus.Official){<a class="btn btn-primary btn-lg" asp-action="Diploma" asp-route-id="@Model.Id">Descargar diploma PDF</a>}else{<span style="display:block;color:#f9c767;font-size:14px;font-weight:700">Vista previa del organizador. El diploma estará disponible después de publicar los resultados oficiales.</span>}<a class="btn btn-ghost btn-lg" asp-action="Event" asp-route-slug="@r.Event.Slug">Volver a resultados</a></div></section>
