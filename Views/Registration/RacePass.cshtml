@model Registration
@{ ViewData["Title"] = "Race Pass"; ViewData["BodyClass"] = "race-pass-page"; }
<section class="race-pass-wrap"><div class="race-pass"><div class="pass-top"><span class="brand-mark">ST</span><div><small>RACE PASS</small><strong>@Model.Event.Name</strong></div><span class="status-pill ok">PAGO OK</span></div><div class="pass-body"><div class="pass-rider"><span>DORSAL</span><strong>@(Model.BibNumber ?? "—")</strong><h1>@Model.Cyclist.FirstName<br/>@Model.Cyclist.LastName</h1><p>@Model.Category.Name · @Model.EventDistance.Name</p></div><div class="pass-qr"><img src="/qr/@Model.QrToken" alt="QR Race Pass"/><small>@Model.QrToken.ToString()[..8].ToUpperInvariant()</small></div></div><div class="pass-footer"><div><small>FECHA</small><b>@Model.Event.StartDate.ToString("dd MMM yyyy")</b></div><div><small>ACREDITACIÓN</small><b>@Model.CheckInStatus</b></div><div><small>ID</small><b>#ST-@Model.Id.ToString("D4")</b></div></div></div><p class="pass-hint">Presentá este QR en acreditación. Podés guardar esta pantalla en el teléfono.</p></section>
