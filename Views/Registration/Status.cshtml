@model Registration
@{ ViewData["Title"] = "Estado de inscripción"; var approved = Model.PaymentStatus == PaymentStatus.Approved; }
<section class="state-page"><div class="state-card state-card-wide"><span class="state-icon @(approved?"success":"pending")">@(approved?"✓":"…")</span><span class="eyebrow">INSCRIPCIÓN #ST-@Model.Id.ToString("D4")</span><h1>@(approved ? "Estás adentro." : "Tu inscripción está creada.")</h1><p>@Model.Cyclist.FirstName, tu cupo para <strong>@Model.Event.Name</strong> @(approved ? "quedó confirmado." : "está esperando la confirmación del pago.")</p><div class="status-grid"><div><small>ESTADO</small><strong class="status-pill @(approved?"ok":"pending")">@Model.Status</strong></div><div><small>PAGO</small><strong class="status-pill @(approved?"ok":"pending")">@Model.PaymentStatus</strong></div><div><small>DISTANCIA</small><strong>@Model.EventDistance.Name</strong></div><div><small>CATEGORÍA</small><strong>@Model.Category.Name</strong></div></div>@if(approved){<a class="btn btn-primary btn-lg" asp-action="RacePass" asp-route-id="@Model.Id">Abrir Race Pass <span>→</span></a>} else {<div class="notice"><b>El retorno del checkout no confirma el pago.</b><span>SprinTime actualiza esta pantalla cuando Mercado Pago notifica y el backend verifica la operación.</span></div>@if(ViewBag.IsDevelopment == true){<form asp-action="DemoApprove" method="post"><input type="hidden" name="id" value="@Model.Id"/><button class="btn btn-outline" type="submit">Aprobar pago demo (solo desarrollo)</button></form>}}</div></section>
