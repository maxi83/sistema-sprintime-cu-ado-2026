@model RegistrationInputModel
@{ var race = (Event)ViewBag.Event; ViewData["Title"] = "Inscripción · " + race.Name; }
<section class="page-hero form-hero"><div class="shell"><span class="eyebrow">INSCRIPCIÓN ONLINE</span><h1>Tu lugar en <em>@race.Name</em></h1><p>Completá los datos, elegí distancia y categoría. El cupo queda confirmado únicamente con el pago aprobado.</p></div></section>
<section class="section form-section"><div class="shell form-layout"><form asp-action="Create" method="post" class="premium-form" data-registration-form><input type="hidden" asp-for="EventId" />
<div asp-validation-summary="ModelOnly" class="validation-summary"></div>
<div class="form-card"><div class="form-card-head"><span>01</span><div><h2>Competencia</h2><p>Elegí cómo vas a correr.</p></div></div><div class="choice-grid" data-distance-grid>@foreach(var d in race.Distances){<label class="choice-card @(Model.EventDistanceId==d.Id?"selected":"")"><input type="radio" asp-for="EventDistanceId" value="@d.Id" data-distance data-price="@d.Price" /><span><b>@d.Name</b><small>@d.Kilometers.ToString("0.#") km · $@d.Price.ToString("N0")</small></span><i>✓</i></label>}</div><span asp-validation-for="EventDistanceId" class="field-error"></span><label class="field"><span>Categoría</span><select asp-for="CategoryId" data-category-select><option value="">Seleccioná categoría</option>@foreach(var d in race.Distances){foreach(var c in d.Categories){<option value="@c.Id" data-distance-id="@d.Id">@c.Name</option>}}</select><span asp-validation-for="CategoryId" class="field-error"></span></label></div>
<div class="form-card"><div class="form-card-head"><span>02</span><div><h2>Tu perfil ciclista</h2><p>Datos recuperados de tu cuenta, no necesitás completarlos de nuevo.</p></div></div><p><strong>@Model.FirstName @Model.LastName</strong> · DNI @Model.Dni</p><p>@Model.Email</p><p>Para cambiar los datos de tu perfil, contactá al organizador.</p></div>
<div class="form-card"><div class="form-card-head"><span>03</span><div><h2>Emergencia y confirmación</h2><p>Información importante para el día de carrera.</p></div></div><p>Contacto de emergencia registrado en tu perfil: <strong>@Model.EmergencyContact</strong> · @Model.EmergencyPhone</p><label class="check-field"><input asp-for="AcceptTerms" required aria-required="true"/><span>Acepto el reglamento, la declaración de responsabilidad y el tratamiento de mis datos para operar esta inscripción.</span></label><span asp-validation-for="AcceptTerms" class="field-error"></span></div>
<button class="btn btn-primary btn-lg btn-block" type="submit">Continuar al pago <span>→</span></button></form>
<aside class="checkout-summary"><div class="summary-card"><span class="eyebrow">TU INSCRIPCIÓN</span><h3>@race.Name</h3><p>@race.StartDate.ToString("dd MMM yyyy · HH:mm")<br/>@race.City, @race.Province</p><hr/><div class="summary-row"><span>Inscripción</span><b data-summary-distance>Elegí una distancia</b></div><div class="summary-row total"><span>Total</span><b data-summary-price>—</b></div><small class="secure-note">● Pago verificado en servidor. Volver del checkout no confirma el cupo.</small></div></aside></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
