@model RegistrationInputModel
@{ var race = (Event)ViewBag.Event; ViewData["Title"] = "Inscripción · " + race.Name; }
<section class="page-hero form-hero"><div class="shell"><span class="eyebrow">INSCRIPCIÓN ONLINE</span><h1>Tu lugar en <em>@race.Name</em></h1><p>Completá los datos, elegí distancia y categoría. El cupo queda confirmado únicamente con el pago aprobado.</p></div></section>
<section class="section form-section"><div class="shell form-layout"><form asp-action="Create" method="post" class="premium-form" data-registration-form><input type="hidden" asp-for="EventId" />
<div asp-validation-summary="ModelOnly" class="validation-summary"></div>
<div class="form-card"><div class="form-card-head"><span>01</span><div><h2>Competencia</h2><p>Elegí cómo vas a correr.</p></div></div><div class="choice-grid" data-distance-grid>@foreach(var d in race.Distances){<label class="choice-card @(Model.EventDistanceId==d.Id?"selected":"")"><input type="radio" asp-for="EventDistanceId" value="@d.Id" data-distance data-price="@d.Price" /><span><b>@d.Name</b><small>@d.Kilometers.ToString("0.#") km · $@d.Price.ToString("N0")</small></span><i>✓</i></label>}</div><span asp-validation-for="EventDistanceId" class="field-error"></span><label class="field"><span>Categoría</span><select asp-for="CategoryId" data-category-select><option value="">Seleccioná categoría</option>@foreach(var d in race.Distances){foreach(var c in d.Categories){<option value="@c.Id" data-distance-id="@d.Id">@c.Name</option>}}</select><span asp-validation-for="CategoryId" class="field-error"></span></label></div>
<div class="form-card"><div class="form-card-head"><span>02</span><div><h2>Datos del ciclista</h2><p>Los usamos para tu inscripción y Race Pass.</p></div></div><div class="field-grid"><label class="field"><span>Nombre</span><input asp-for="FirstName" autocomplete="given-name"/><span asp-validation-for="FirstName" class="field-error"></span></label><label class="field"><span>Apellido</span><input asp-for="LastName" autocomplete="family-name"/><span asp-validation-for="LastName" class="field-error"></span></label><label class="field"><span>DNI</span><input asp-for="Dni" inputmode="numeric"/><span asp-validation-for="Dni" class="field-error"></span></label><label class="field"><span>Fecha de nacimiento</span><input asp-for="BirthDate" type="date"/><span asp-validation-for="BirthDate" class="field-error"></span></label><label class="field"><span>Email</span><input asp-for="Email" type="email" autocomplete="email"/><span asp-validation-for="Email" class="field-error"></span></label><label class="field"><span>Teléfono</span><input asp-for="Phone" autocomplete="tel"/><span asp-validation-for="Phone" class="field-error"></span></label><label class="field"><span>Ciudad</span><input asp-for="City"/><span asp-validation-for="City" class="field-error"></span></label><label class="field"><span>Equipo / club</span><input asp-for="Team"/><span asp-validation-for="Team" class="field-error"></span></label></div></div>
<div class="form-card"><div class="form-card-head"><span>03</span><div><h2>Emergencia y confirmación</h2><p>Información importante para el día de carrera.</p></div></div><div class="field-grid"><label class="field"><span>Contacto de emergencia</span><input asp-for="EmergencyContact"/><span asp-validation-for="EmergencyContact" class="field-error"></span></label><label class="field"><span>Teléfono de emergencia</span><input asp-for="EmergencyPhone"/><span asp-validation-for="EmergencyPhone" class="field-error"></span></label></div><label class="check-field"><input asp-for="AcceptTerms"/><span>Acepto el reglamento, la declaración de responsabilidad y el tratamiento de mis datos para operar esta inscripción.</span></label><span asp-validation-for="AcceptTerms" class="field-error"></span></div>
<button class="btn btn-primary btn-lg btn-block" type="submit">Continuar al pago <span>→</span></button></form>
<aside class="checkout-summary"><div class="summary-card"><span class="eyebrow">TU INSCRIPCIÓN</span><h3>@race.Name</h3><p>@race.StartDate.ToString("dd MMM yyyy · HH:mm")<br/>@race.City, @race.Province</p><hr/><div class="summary-row"><span>Inscripción</span><b data-summary-distance>Elegí una distancia</b></div><div class="summary-row total"><span>Total</span><b data-summary-price>—</b></div><small class="secure-note">● Pago verificado en servidor. Volver del checkout no confirma el cupo.</small></div></aside></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
