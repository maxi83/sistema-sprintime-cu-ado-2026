@model List<RankingRowViewModel>
@{ ViewData["Title"] = "Ranking"; }
<section class="page-hero compact ranking-hero"><div class="shell"><span class="eyebrow">TEMPORADA @DateTime.Now.Year</span><h1>Una carrera vende <em>la siguiente.</em></h1><p>Puntos por participación y resultado. El ranking crece con cada competencia.</p></div></section>
<section class="section"><div class="shell"><div class="ranking-board"><div class="ranking-title"><span>RANKING GENERAL</span><b>@DateTime.Now.Year</b></div>@foreach(var r in Model){<div class="ranking-row @(r.Position<=3?"podium":"")"><span class="rank-pos">@r.Position</span><div class="rank-person"><b>@r.CyclistName</b><small>@r.Team · @r.Category</small></div><div><small>CARRERAS</small><b>@r.Races</b></div><div><small>PODIOS</small><b>@r.Podiums</b></div><strong>@r.Points <small>PTS</small></strong></div>}@if(Model.Count==0){<div class="table-empty">El ranking se activa cuando se publican resultados.</div>}</div></div></section>
