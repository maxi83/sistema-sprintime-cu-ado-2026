@model List<TimingRecord>
@{ var race=(Event)ViewBag.Event; var cp=(Checkpoint)ViewBag.Checkpoint; ViewData["Title"]=$"{cp.Name} · Race Day"; ViewData["BodyClass"]="race-day-page"; }
<section class="race-day timing-screen" data-timing-screen data-event-id="@race.Id" data-checkpoint-id="@cp.Id"><div class="race-day-top"><div><a asp-action="Index" asp-route-eventId="@race.Id">← RACE DAY</a><span class="live-dot">@cp.Type.ToString().ToUpperInvariant()</span><h1>@cp.Name</h1><p>@race.Name · km @cp.Kilometer.ToString("0.#")</p></div><div class="network-badge" data-network><i></i><span>Conectado</span></div></div><div class="timing-console"><div class="timing-entry"><span class="eyebrow">REGISTRAR DORSAL</span><div class="big-input"><input inputmode="numeric" autocomplete="off" autofocus placeholder="000" data-bib-input/><button type="button" data-register-pass>REGISTRAR</button></div><p data-timing-message>Ingresá el dorsal y presioná Enter. Sin señal, el registro queda guardado en este dispositivo.</p><div class="offline-queue">COLA OFFLINE <strong data-queue-count>0</strong><button type="button" data-sync-queue>Sincronizar</button></div></div><div class="timing-last"><small>ÚLTIMO PASO</small><strong data-last-time>--:--:--</strong><h2 data-last-name>Esperando corredor</h2><span data-last-bib>—</span></div></div><div class="timing-history"><div class="timing-history-head"><span>REGISTROS RECIENTES</span><b>@Model.Count</b></div>@foreach(var item in Model){<div><strong>@item.Registration.BibNumber</strong><p>@item.Registration.Cyclist.FirstName @item.Registration.Cyclist.LastName</p><time>@item.TimestampUtc.ToLocalTime().ToString("HH:mm:ss")</time></div>}</div></section>
