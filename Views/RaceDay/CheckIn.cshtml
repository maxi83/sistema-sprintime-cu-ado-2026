@model List<Registration>
@{ var race=(Event)ViewBag.Event; ViewData["Title"]="Acreditación · "+race.Name; ViewData["BodyClass"]="race-day-page"; }
<section class="race-day checkin-screen"><div class="race-day-top"><div><a asp-action="Index" asp-route-eventId="@race.Id">← RACE DAY</a><span class="live-dot">CHECK-IN</span><h1>Acreditación</h1><p>Escaneá el QR o buscá al corredor.</p></div></div><form method="get" class="race-search"><input type="hidden" name="eventId" value="@race.Id"/><input autofocus name="q" value="@ViewBag.Query" placeholder="QR · DNI · dorsal · nombre" autocomplete="off"/><button type="submit">BUSCAR</button></form><div class="checkin-results">@foreach(var r in Model){<article class="checkin-card"><div class="checkin-bib">@(r.BibNumber??"—")<small>DORSAL</small></div><div class="checkin-person"><h2>@r.Cyclist.FirstName @r.Cyclist.LastName</h2><p>@r.Category.Name · @r.EventDistance.Name · DNI @r.Cyclist.Dni</p><div><span class="status-pill @(r.PaymentStatus==PaymentStatus.Approved?"ok":"pending")">@(r.PaymentStatus==PaymentStatus.Approved?"PAGO CONFIRMADO":"PAGO PENDIENTE · NO ACREDITAR")</span><span class="status-pill @(r.CheckInStatus==CheckInStatus.Pending?"pending":"ok")">@r.CheckInStatus</span></div></div>@if(r.PaymentStatus!=PaymentStatus.Approved){<span class="race-done">Esperando pago</span>}else if(r.CheckInStatus==CheckInStatus.Pending){<form asp-action="ConfirmCheckIn" method="post"><input type="hidden" name="registrationId" value="@r.Id"/><button class="race-confirm" type="submit">ACREDITAR ✓</button></form>}else{<span class="race-done">LISTO ✓</span>}</article>}@if(!string.IsNullOrWhiteSpace(ViewBag.Query as string) && Model.Count==0){<div class="race-empty">No encontramos un corredor con ese dato en esta carrera.</div>}</div></section>
