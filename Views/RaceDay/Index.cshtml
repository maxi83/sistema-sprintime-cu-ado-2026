@model RaceDayViewModel
@{ ViewData["Title"]="Race Day · "+Model.Event.Name; ViewData["BodyClass"]="race-day-page"; }
<section class="race-day"><nav aria-label="Navegación de Race Day" style="display:flex;flex-wrap:wrap;gap:10px;margin-bottom:24px"><a class="btn btn-ghost" asp-controller="Admin" asp-action="Dashboard" asp-route-eventId="@Model.Event.Id">← Panel del organizador</a><a class="btn btn-ghost" asp-controller="Admin" asp-action="Participants" asp-route-eventId="@Model.Event.Id">Participantes y pagos</a><a class="btn btn-ghost" asp-controller="RaceDay" asp-action="CheckIn" asp-route-eventId="@Model.Event.Id">Acreditación</a></nav><div class="race-day-top"><div><a asp-controller="Admin" asp-action="Dashboard" asp-route-eventId="@Model.Event.Id">← CONTROL CENTER</a><span class="live-dot">RACE DAY</span><h1>@Model.Event.Name</h1><p>@Model.Event.StartDate.ToString("dd MMM · HH:mm") · @Model.Event.City</p></div><div class="network-badge" data-network><i></i><span>Conectado</span></div></div><div class="race-day-metrics"><div><small>CONFIRMADOS</small><strong>@Model.Confirmed</strong></div><div><small>ACREDITADOS</small><strong>@Model.Accredited</strong></div><div><small>EN CARRERA</small><strong>@Model.Started</strong></div><div><small>FINALIZADOS</small><strong>@Model.Finished</strong></div></div>@if (!Model.Checkpoints.Any(x => x.Type == TimingPointType.Start) || !Model.Checkpoints.Any(x => x.Type == TimingPointType.Finish))
{
    <section style="margin:26px 0;padding:22px;border:1px solid rgba(255,255,255,.2);border-radius:16px;background:#293033;color:#fff">
        <h2 style="font-size:1.25rem;margin:0 0 8px">Preparar cronometraje</h2>
        <p style="margin:0 0 14px">Esta carrera todavía no tiene configuradas las estaciones de salida y llegada. Crealas para registrar dorsales y generar resultados.</p>
        @if (User.IsInRole("Administrator") || User.IsInRole("Organizer"))
        {
            <form asp-controller="RaceDay" asp-action="ConfigureStartFinish" method="post">
                <input type="hidden" name="eventId" value="@Model.Event.Id" />
                <button type="submit" class="btn btn-primary">Configurar salida y llegada</button>
            </form>
        }
        else
        {
            <p>Pedile al organizador que configure las estaciones de cronometraje.</p>
        }
    </section>
}
<div class="race-day-grid"><a class="race-action-card checkin" asp-action="CheckIn" asp-route-eventId="@Model.Event.Id"><span>01</span><div><small>ACREDITACIÓN</small><h2>Race Pass Check-in</h2><p>Buscar por QR, DNI, nombre o dorsal.</p></div><b>ABRIR →</b></a>@foreach(var cp in Model.Checkpoints){<a class="race-action-card timing" asp-action="Timing" asp-route-eventId="@Model.Event.Id" asp-route-checkpointId="@cp.Id"><span>@cp.Order.ToString("D2")</span><div><small>@cp.Type.ToString().ToUpperInvariant()</small><h2>@cp.Name</h2><p>km @cp.Kilometer.ToString("0.#") · registro de dorsales</p></div><b>OPERAR →</b></a>}</div></section>
