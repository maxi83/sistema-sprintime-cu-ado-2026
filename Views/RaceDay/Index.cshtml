@model RaceDayViewModel
@{ ViewData["Title"]="Race Day · "+Model.Event.Name; ViewData["BodyClass"]="race-day-page"; }
<section class="race-day"><div class="race-day-top"><div><a asp-controller="Admin" asp-action="Dashboard" asp-route-eventId="@Model.Event.Id">← CONTROL CENTER</a><span class="live-dot">RACE DAY</span><h1>@Model.Event.Name</h1><p>@Model.Event.StartDate.ToString("dd MMM · HH:mm") · @Model.Event.City</p></div><div class="network-badge" data-network><i></i><span>Conectado</span></div></div><div class="race-day-metrics"><div><small>CONFIRMADOS</small><strong>@Model.Confirmed</strong></div><div><small>ACREDITADOS</small><strong>@Model.Accredited</strong></div><div><small>EN CARRERA</small><strong>@Model.Started</strong></div><div><small>FINALIZADOS</small><strong>@Model.Finished</strong></div></div><div class="race-day-grid"><a class="race-action-card checkin" asp-action="CheckIn" asp-route-eventId="@Model.Event.Id"><span>01</span><div><small>ACREDITACIÓN</small><h2>Race Pass Check-in</h2><p>Buscar por QR, DNI, nombre o dorsal.</p></div><b>ABRIR →</b></a>@foreach(var cp in Model.Checkpoints){<a class="race-action-card timing" asp-action="Timing" asp-route-eventId="@Model.Event.Id" asp-route-checkpointId="@cp.Id"><span>@cp.Order.ToString("D2")</span><div><small>@cp.Type.ToString().ToUpperInvariant()</small><h2>@cp.Name</h2><p>km @cp.Kilometer.ToString("0.#") · registro de dorsales</p></div><b>OPERAR →</b></a>}</div></section>
