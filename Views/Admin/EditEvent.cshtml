@model EventEditViewModel
@{ ViewData["Title"] = Model.Id.HasValue ? "Editar carrera" : "Nueva carrera"; ViewData["BodyClass"]="admin-page"; }
<section class="admin-standalone"><div class="shell narrow"><div class="admin-topbar"><div><a class="back-link" asp-action="Dashboard" asp-route-eventId="@Model.Id">← Control Center</a><span class="eyebrow">CONFIGURACIÓN DE EVENTO</span><h1>@(Model.Id.HasValue?"Editar carrera":"Crear nueva carrera")</h1><p>La ficha pública y la operación comparten la misma fuente de datos.</p></div></div><form asp-action="EditEvent" method="post" class="premium-form admin-form"><input type="hidden" asp-for="Id"/><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-card"><div class="form-card-head"><span>01</span><div><h2>Identidad y publicación</h2><p>Cómo se presenta el evento.</p></div></div><div class="field-grid"><label class="field span-2"><span>Nombre</span><input asp-for="Name"/></label><label class="field"><span>Slug</span><input asp-for="Slug"/></label><label class="field"><span>Estado</span><select asp-for="Status" asp-items="Html.GetEnumSelectList<EventStatus>()"></select></label><label class="field span-2"><span>Descripción</span><textarea asp-for="Description" rows="5"></textarea></label><label class="field span-2"><span>Imagen hero (URL o /images/...)</span><input asp-for="HeroImageUrl"/></label></div></div><div class="form-card"><div class="form-card-head"><span>02</span><div><h2>Fecha y ubicación</h2><p>Define también la ventana de inscripción.</p></div></div><div class="field-grid"><label class="field"><span>Ciudad</span><input asp-for="City"/></label><label class="field"><span>Provincia</span><input asp-for="Province"/></label><label class="field span-2"><span>Lugar</span><input asp-for="Venue"/></label><label class="field"><span>Inicio de carrera</span><input asp-for="StartDate" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}"/></label><label class="field"><span>Apertura inscripción</span><input asp-for="RegistrationOpenAt" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}"/></label><label class="field"><span>Cierre inscripción</span><input asp-for="RegistrationCloseAt" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}"/></label><label class="field"><span>Desnivel +m</span><input asp-for="ElevationGainMeters" type="number"/></label></div></div><div class="form-card"><div class="form-card-head"><span>03</span><div><h2>Distancias y categorías</h2><p>Una carrera puede tener múltiples recorridos.</p></div></div><div data-distance-editor>@for(var i=0;i<Model.Distances.Count;i++){<div class="distance-editor-row"><input type="hidden" asp-for="Distances[i].Id"/><label class="field"><span>Nombre</span><input asp-for="Distances[i].Name"/></label><label class="field"><span>Kilómetros</span><input asp-for="Distances[i].Kilometers" type="number" step="0.1"/></label><label class="field"><span>Precio</span><input asp-for="Distances[i].Price" type="number" step="1"/></label><label class="field"><span>Cupo</span><input asp-for="Distances[i].MaxParticipants" type="number"/></label><label class="field span-2"><span>Categorías (separadas por coma)</span><input asp-for="Distances[i].Categories"/></label></div>}</div><p class="form-note">Para agregar más distancias, guardá el evento y repetí el bloque desde una actualización posterior. La arquitectura ya soporta múltiples distancias.</p></div><div class="form-card"><div class="form-card-head"><span>04</span><div><h2>Archivos y reglas</h2><p>Recorrido, reglamento y operación.</p></div></div><div class="field-grid"><label class="field"><span>Reglamento URL</span><input asp-for="RegulationUrl"/></label><label class="field"><span>GPX URL</span><input asp-for="GpxUrl"/></label></div><label class="check-field"><input asp-for="ShowPublicParticipants"/><span>Permitir lista pública de inscriptos</span></label><label class="check-field"><input asp-for="AllowOnsiteRegistration"/><span>Permitir inscripción presencial después del cierre</span></label></div><button class="btn btn-primary btn-lg" type="submit">Guardar carrera <span>→</span></button></form></div></section>
