@model AdminDashboardViewModel
@{ ViewData["Title"] = "Control Center"; ViewData["BodyClass"] = "admin-page"; }
<section class="admin-shell"><aside class="admin-sidebar"><div class="admin-side-brand"><span class="brand-mark">ST</span><div><b>Control Center</b><small>@Model.Event.Name</small></div></div><nav><a class="active" asp-action="Dashboard" asp-route-eventId="@Model.Event.Id"><span>◫</span>Resumen</a><a asp-action="Participants" asp-route-eventId="@Model.Event.Id"><span>◎</span>Participantes</a><a asp-action="EditEvent" asp-route-id="@Model.Event.Id"><span>✎</span>Evento</a><a asp-controller="RaceDay" asp-action="Index" asp-route-eventId="@Model.Event.Id"><span>⌁</span>Race Day</a><a asp-controller="Results" asp-action="Event" asp-route-slug="@Model.Event.Slug"><span>↗</span>Resultados</a></nav><form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="side-logout">Cerrar sesión</button></form></aside><div class="admin-main"><div class="admin-topbar"><div><span class="eyebrow">EVENTO ACTIVO</span><h1>@Model.Event.Name</h1><p>@Model.Event.StartDate.ToString("dd MMM yyyy · HH:mm") · @Model.Event.City</p></div><div class="admin-actions"><a class="btn btn-primary" asp-action="EditEvent">+ Crear carrera</a><a class="btn btn-outline" asp-controller="Events" asp-action="Details" asp-route-slug="@Model.Event.Slug">@(Model.Event.Status == EventStatus.Draft ? "Vista previa (borrador)" : "Ver público ↗")</a><a class="btn btn-primary" asp-controller="RaceDay" asp-action="Index" asp-route-eventId="@Model.Event.Id">Abrir Race Day</a></div></div>
<div class="metric-grid"><article><span>INSCRIPTOS</span><strong>@Model.Registrations</strong><small>Total del evento</small></article><article><span>PAGOS APROBADOS</span><strong>@Model.ApprovedPayments</strong><small>@Model.PaymentRate.ToString("0")% conversión</small></article><article><span>ACREDITADOS</span><strong>@Model.Accredited</strong><small>Race Pass confirmado</small></article><article class="metric-accent"><span>RECAUDACIÓN</span><strong>$@Model.Revenue.ToString("N0")</strong><small>Pagos aprobados</small></article></div>
<div class="admin-grid"><section class="admin-card"><div class="admin-card-head"><div><span>ÚLTIMAS INSCRIPCIONES</span><h2>Movimiento reciente</h2></div><a asp-action="Participants" asp-route-eventId="@Model.Event.Id">Ver todos →</a></div><div class="compact-list">@foreach(var r in Model.LatestRegistrations){<div><span class="avatar">@r.Cyclist.FirstName.First()@r.Cyclist.LastName.First()</span><p><b>@r.Cyclist.FirstName @r.Cyclist.LastName</b><small>@r.EventDistance.Name · @r.Category.Name</small></p><span class="status-pill @(r.PaymentStatus==PaymentStatus.Approved?"ok":r.PaymentStatus==PaymentStatus.Pending?"pending":"bad")">@r.PaymentStatus</span></div>}</div></section><aside class="admin-card quick-card"><div class="admin-card-head"><div><span>ACCIONES RÁPIDAS</span><h2>Operación</h2></div></div><a asp-action="SocialLinks">Redes sociales y WhatsApp <span>→</span></a><a asp-action="EditEvent">+ Crear otra carrera <span>→</span></a><a asp-action="EditEvent" asp-route-id="@Model.Event.Id">Editar ficha pública <span>→</span></a><a asp-action="Participants" asp-route-eventId="@Model.Event.Id">Gestionar participantes <span>→</span></a><a asp-controller="RaceDay" asp-action="CheckIn" asp-route-eventId="@Model.Event.Id">Abrir acreditación <span>→</span></a><a asp-controller="RaceDay" asp-action="Index" asp-route-eventId="@Model.Event.Id">Abrir Race Day <span>→</span></a></aside></div>
<div class="admin-grid export-grid"><section class="admin-card"><div class="admin-card-head"><div><span>CIERRE + EXPORTACIÓN</span><h2>Archivo para el día de carrera</h2></div></div><p class="admin-copy">Al cerrar la inscripción, SprinTime deja una nómina limpia con pagos confirmados para descargar en el formato que use el programa de cronometraje.</p><div class="export-actions"><a class="btn btn-dark" asp-action="Export" asp-route-eventId="@Model.Event.Id" asp-route-format="pdf">PDF</a><a class="btn btn-outline" asp-action="Export" asp-route-eventId="@Model.Event.Id" asp-route-format="csv">CSV</a><a class="btn btn-outline" asp-action="Export" asp-route-eventId="@Model.Event.Id" asp-route-format="txt">TXT</a></div><small class="secure-note">El TXT actual es un formato interoperable base. Se ajusta al layout exacto del software de Lucho cuando conozcamos su especificación.</small></section><section class="admin-card danger-card"><div class="admin-card-head"><div><span>VENTANA DE INSCRIPCIÓN</span><h2>@Model.Event.RegistrationCloseAt.ToString("dd/MM · HH:mm")</h2></div></div><p class="admin-copy">Estado: <strong>@Model.Event.Status</strong>. El cierre manual impide nuevas inscripciones desde ese momento.</p><form asp-action="CloseRegistration" method="post" onsubmit="return confirm('¿Cerrar las inscripciones ahora?');"><input type="hidden" name="eventId" value="@Model.Event.Id"/><button class="btn btn-danger" type="submit">Cerrar inscripciones</button></form></section></div>
</div></section>
