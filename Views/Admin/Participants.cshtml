@model List<Registration>
@{ var race=(Event)ViewBag.Event; ViewData["Title"]="Participantes · "+race.Name; ViewData["BodyClass"]="admin-page"; }
<section class="admin-standalone"><div class="shell"><div class="admin-topbar"><div><a class="back-link" asp-action="Dashboard" asp-route-eventId="@race.Id">← Control Center</a><span class="eyebrow">PARTICIPANTES</span><h1>@race.Name</h1><p>@Model.Count registros visibles con los filtros actuales.</p></div><div class="admin-actions"><a class="btn btn-outline" asp-action="Export" asp-route-eventId="@race.Id" asp-route-format="csv">Exportar CSV</a><a class="btn btn-primary" asp-controller="RaceDay" asp-action="CheckIn" asp-route-eventId="@race.Id">Acreditación</a></div></div><form method="get" class="filter-bar"><input type="hidden" name="eventId" value="@race.Id"/><input type="search" name="q" value="@ViewBag.Query" placeholder="Nombre, DNI o dorsal"/><select name="payment"><option value="">Todos los pagos</option>@foreach(var p in Enum.GetValues<PaymentStatus>()){<option value="@p" selected="@(ViewBag.Payment as string == p.ToString())">@p</option>}</select><button class="btn btn-dark">Filtrar</button></form><div class="table-shell"><table class="data-table"><thead><tr><th>Corredor</th><th>DNI</th><th>Distancia</th><th>Categoría</th><th>Pago</th><th>Dorsal</th><th>Check-in</th></tr></thead><tbody>@foreach(var r in Model){<tr><td><b>@r.Cyclist.LastName, @r.Cyclist.FirstName</b><small>@r.Cyclist.Email</small></td><td>@r.Cyclist.Dni</td><td>@r.EventDistance.Name</td><td>@r.Category.Name</td><td><span class="status-pill @(r.PaymentStatus==PaymentStatus.Approved?"ok":r.PaymentStatus==PaymentStatus.Pending?"pending":"bad")">@r.PaymentStatus</span></td><td><form asp-action="AssignBib" method="post" class="bib-form"><input type="hidden" name="registrationId" value="@r.Id"/><input name="bibNumber" value="@r.BibNumber" placeholder="—"/><button>✓</button></form></td><td>@r.CheckInStatus</td></tr>}</tbody></table></div></div></section>
