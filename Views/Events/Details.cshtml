@model Event
@{ ViewData["Title"] = Model.Name; var open = DateTime.Now >= Model.RegistrationOpenAt && DateTime.Now <= Model.RegistrationCloseAt && Model.Status is EventStatus.Published or EventStatus.RegistrationOpen; }
<section class="event-hero" style="--event-image:url('@(Model.HeroImageUrl ?? "/images/hero-race.svg")')"><div class="event-overlay"></div><div class="shell event-hero-inner"><div class="event-title"><span class="race-status @(open ? "open" : "closed")">@(open ? "INSCRIPCIONES ABIERTAS" : "INSCRIPCIÓN CERRADA")</span><h1>@Model.Name</h1><p>@Model.City, @Model.Province · @Model.StartDate.ToString("dd MMM yyyy · HH:mm")</p><div class="event-hero-actions">@if(open){<a class="btn btn-primary btn-lg" asp-controller="Registration" asp-action="Create" asp-route-eventId="@Model.Id">Inscribirme ahora <span>→</span></a>}<a href="#recorrido" class="btn btn-glass btn-lg">Ver recorrido</a></div></div><div class="event-stats"><div><small>DISTANCIA</small><strong>@string.Join(" / ", Model.Distances.Select(x => $"{x.Kilometers:0}K"))</strong></div><div><small>DESNIVEL</small><strong>+@Model.ElevationGainMeters m</strong></div><div><small>CHECKPOINTS</small><strong>@Model.Checkpoints.Count</strong></div></div></div></section>

<section class="section event-detail"><div class="shell detail-grid"><article class="detail-main"><span class="eyebrow">LA CARRERA</span><h2>Todo lo importante, antes de preguntar por WhatsApp.</h2><p class="lead">@Model.Description</p>
    <div class="distance-grid">@foreach(var d in Model.Distances){<div class="distance-card"><div><span>@d.Name</span><strong>@d.Kilometers.ToString("0.#") km</strong></div><p>@d.Categories.Count categorías · @(d.MaxParticipants?.ToString() ?? "Sin límite") cupos</p><b>$@d.Price.ToString("N0")</b>@if(open){<a asp-controller="Registration" asp-action="Create" asp-route-eventId="@Model.Id" asp-route-distanceId="@d.Id">Elegir distancia →</a>}</div>}</div>
    <div id="recorrido" class="route-panel"><div class="route-art"><span class="route-line"></span><i class="route-pin p1"></i><i class="route-pin p2"></i><i class="route-pin p3"></i></div><div><span class="eyebrow">RECORRIDO OFICIAL</span><h3>Route Intelligence</h3><p>Distancia, desnivel, checkpoints y archivo GPX organizados como parte central del evento.</p><div class="route-points">@foreach(var cp in Model.Checkpoints.OrderBy(x=>x.Order)){<span><i></i><b>@cp.Name</b><small>km @cp.Kilometer.ToString("0.#")</small></span>}</div>@if(!string.IsNullOrWhiteSpace(Model.GpxUrl)){<a href="@Model.GpxUrl" class="btn btn-outline">Descargar GPX</a>}</div></div>
</article>
<aside class="detail-aside"><div class="info-card sticky-card"><span class="eyebrow">INFORMACIÓN ACCIONABLE</span><ul class="info-list"><li><span>◷</span><div><small>FECHA Y HORA</small><b>@Model.StartDate.ToString("dddd dd 'de' MMMM · HH:mm")</b></div></li><li><span>⌖</span><div><small>LUGAR</small><b>@Model.Venue, @Model.City</b></div></li><li><span>◎</span><div><small>CIERRE DE INSCRIPCIÓN</small><b>@Model.RegistrationCloseAt.ToString("dd/MM · HH:mm")</b></div></li><li><span>✓</span><div><small>ACREDITACIÓN</small><b>Race Pass QR + control de pago</b></div></li></ul>@if(open){<a class="btn btn-primary btn-block" asp-controller="Registration" asp-action="Create" asp-route-eventId="@Model.Id">Inscribirme ahora</a>}@if(!string.IsNullOrWhiteSpace(Model.RegulationUrl)){<a class="btn btn-outline btn-block" href="@Model.RegulationUrl">Ver reglamento</a>}<a class="btn btn-outline btn-block" asp-controller="Follow" asp-action="Index" asp-route-slug="@Model.Slug">Seguir corredor</a></div></aside></div></section>
@if(Model.Sponsors.Count>0){<section class="sponsor-strip"><div class="shell"><span>ACOMPAÑAN ESTA CARRERA</span><div>@foreach(var sponsor in Model.Sponsors.OrderBy(x=>x.Order)){<b>@sponsor.Name</b>}</div></div></section>}
